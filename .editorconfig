# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyi}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
trim_trailing_whitespace = false
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{toml,json}]
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.{txt,cfg,ini}]
indent_style = space
indent_size = 4
